{
  "name": "vidmoat-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Open Agent Skills for video editing craft, with a dependency-free linter, catalogue generator and eval runner.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "lint": "node tools/lint-skills.mjs",
    "catalogue": "node tools/catalogue.mjs",
    "catalogue:check": "node tools/catalogue.mjs --check",
    "test:tools": "node --test",
    "test": "node tools/lint-skills.mjs && node tools/catalogue.mjs --check && node --test",
    "evals": "node tools/run-evals.mjs",
    "evals:dry": "node tools/run-evals.mjs --dry-run"
  }
}
